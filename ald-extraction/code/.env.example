# 자체 호스팅 텍스트 LLM (DeepSeek) - OpenAI 호환 엔드포인트
ALD_LLM_BASE_URL=https://llm.example.com/v1
ALD_LLM_MODEL=deepseek-v4-pro
ALD_LLM_API_KEY=
# 자체 호스팅 비전 모델 (그림 읽기). 비우면 그림 추출을 건너뜁니다.
ALD_VLM_BASE_URL=https://vlm.example.com/v1
ALD_VLM_MODEL=vision-model
ALD_VLM_API_KEY=
# 그림 반복 추출 횟수 (앙상블)
ALD_FIG_SAMPLES=3
# 데이터 저장 위치
ALD_DATA_DIR=./data
